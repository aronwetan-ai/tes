# Discord Credentials Template
# Copy ke ~/.agent/credentials/discord.env dan isi dengan real values
# chmod 600 ~/.agent/credentials/discord.env
#
# Akun: Disposable user account (selfbot)
# Status: milik agent (Drayco/Rei)
# Note: User token = ToS risk, akun ini adalah akun disposable bukan akun pribadi Fathur

# --- User Token (selfbot method) ---
# Cara dapat: Browser DevTools → Network → cari request ke discord.com/api
# → Header "authorization" = user token
DISCORD_TOKEN=your_user_token_here

# --- Server/Channel Config ---
DISCORD_DEFAULT_GUILD_ID=your_server_id_here
DISCORD_NOTIFY_CHANNEL_ID=your_notification_channel_id

# --- Hermes gateway config ---
# Set ini, lalu jalankan: hermes gateway
# Hermes otomatis connect ke Discord dengan token ini
