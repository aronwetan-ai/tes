# Telegram Credentials Template
# Copy ke ~/.agent/credentials/telegram.env dan isi dengan real values
# chmod 600 ~/.agent/credentials/telegram.env
#
# Akun: Telegram Bot (Drayco/Rei)
# Status: milik agent

# --- Bot Token ---
# Dapat dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Allowed Chat IDs ---
# Kosongkan untuk izinkan semua, atau isi dengan chat ID Fathur
# Cari chat ID: kirim pesan ke bot, cek update dari https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_ALLOWED_CHATS=your_chat_id_here

# --- Hermes gateway config ---
# Set ini, lalu jalankan: hermes gateway
# Hermes otomatis listen ke Telegram
