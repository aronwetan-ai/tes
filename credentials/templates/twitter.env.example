# Twitter / X Credentials Template
# Copy ke ~/.agent/credentials/twitter.env dan isi dengan real values
# chmod 600 ~/.agent/credentials/twitter.env
#
# Akun: SHARED — dipakai oleh @brandflow.social, @brandflow.community, @crypto.research
# Status: milik agent (otonom penuh sesuai UPGRADE2)
# Boundary #4: public posting butuh konfirmasi Fathur

# --- OAuth 2.0 (Recommended untuk API v2) ---
X_CLIENT_ID=your_client_id_here
X_CLIENT_SECRET=your_client_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here
X_BEARER_TOKEN=your_bearer_token_here

# --- Cookie-based (Primary method, paling stabil) ---
# Export cookies dari browser setelah login manual
# Format: Netscape cookie file atau JSON
X_COOKIES_PATH=~/.agent/credentials/x-cookies.json

# --- Fallback: Username + Password ---
X_USERNAME=your_username_here
X_PASSWORD=your_password_here
X_BACKUP_CODES=code1,code2,code3,code4,code5

# --- xurl CLI config ---
# xurl pakai ~/.xurl/config.json setelah `xurl auth login`
# Atau set manual:
XURL_BEARER_TOKEN=$X_BEARER_TOKEN

# --- Akun tambahan (kalau punya lebih dari 1) ---
# Uncomment dan isi kalau ada akun kedua, ketiga, dst
# X2_USERNAME=second_account
# X2_COOKIES_PATH=~/.agent/credentials/x2-cookies.json
