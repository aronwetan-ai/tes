# Crypto Wallet Credentials Template
# Copy ke ~/.agent/credentials/wallet.env dan isi dengan real values
# chmod 600 ~/.agent/credentials/wallet.env
#
# PERINGATAN: File ini berisi private key — JANGAN PERNAH commit ke repo
# JANGAN PERNAH paste isi file ini di chat, log, atau context apapun
#
# Akun: milik agent (otonom penuh sesuai UPGRADE2)
# Kemampuan: swap, bridge, mint, delegate, transfer
# Batas: x402 payment ke merchant baru = wajib konfirmasi Fathur

# --- EVM (Ethereum, BSC, Polygon, dll) ---
EVM_PRIVATE_KEY=0xyour_private_key_here
EVM_ADDRESS=0xyour_wallet_address_here
EVM_RPC_URL=https://mainnet.infura.io/v3/your_project_id

# --- Solana ---
SOLANA_PRIVATE_KEY=your_base58_private_key_here
SOLANA_ADDRESS=your_wallet_address_here
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- x402 Payment Whitelist ---
# Merchant yang sudah di-approve untuk recurring payment (otonom)
X402_WHITELIST=merchant1.com,merchant2.com

# --- Backup ---
# Mnemonic disimpan di cold storage TERPISAH, bukan di sini
# JANGAN simpan mnemonic di file ini
