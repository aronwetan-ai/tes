# OpenAI Credentials Template
# Copy ke ~/.agent/credentials/openai.env dan isi dengan real values
# chmod 600 ~/.agent/credentials/openai.env
#
# Dipakai untuk: STT fallback (Whisper API) + LLM fallback kalau provider utama down
# Primary STT: local Whisper (offline, free) — OpenAI hanya fallback

# --- API Key ---
OPENAI_API_KEY=sk-your_api_key_here

# --- Default model config ---
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o
