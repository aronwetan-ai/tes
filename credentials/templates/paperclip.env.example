# Paperclip Credentials Template
# Copy ke ~/.agent/credentials/paperclip.env dan isi dengan real values
# chmod 600 ~/.agent/credentials/paperclip.env
#
# Dipakai untuk: Paperclip control plane authentication (kalau pakai cloud dashboard)
# Untuk local-only setup: file ini optional (Paperclip jalan tanpa auth di localhost)

# --- API Key (kalau pakai Paperclip cloud) ---
PAPERCLIP_API_KEY=your_api_key_here

# --- Company ID ---
PAPERCLIP_COMPANY=ai-holding

# --- Employee ID (Hermes/Rei) ---
PAPERCLIP_EMPLOYEE=rei

# --- Dashboard URL ---
PAPERCLIP_DASHBOARD_URL=http://localhost:4040

# --- Budget settings ---
PAPERCLIP_DAILY_BUDGET=500000  # tokens
PAPERCLIP_ALERT_THRESHOLD=0.8  # 80%
