# Paperclip Credentials Template
# Copy ke ~/.agent/credentials/paperclip.env dan isi dengan real values
# chmod 600 ~/.agent/credentials/paperclip.env
#
# Dipakai untuk: Paperclip API authentication (instance admin + agent API keys)
# Untuk trusted-local mode (default): file ini optional — Paperclip jalan tanpa auth di localhost loopback

# --- Paperclip Server URL ---
# Default: http://localhost:3100 (lokal). Kalau pakai LAN/Tailnet, ganti ke IP/hostname.
PAPERCLIP_API_URL=http://localhost:3100

# --- Instance Admin API Key ---
# Generate via: Paperclip UI → Settings → API Keys → "Create instance admin key"
# Pakai untuk: create company, manage instance-wide settings
PAPERCLIP_INSTANCE_ADMIN_KEY=your_instance_admin_key_here

# --- Company ID ---
# Get setelah create company: response dari POST /api/companies
PAPERCLIP_COMPANY_ID=your_company_uuid_here

# --- Agent API Key (Rei / Drayco as CEO) ---
# Generate via: Paperclip UI → Agent Rei → Settings → API Keys
# Pakai untuk: agent self-queries (paperclipMe, paperclipInbox), comments, etc.
PAPERCLIP_AGENT_API_KEY_REI=your_rei_agent_key_here

# --- Agent IDs (untuk scripting / track_tokens.py reference) ---
PAPERCLIP_AGENT_ID_REI=
PAPERCLIP_AGENT_ID_NEXUSAI_CTO=
PAPERCLIP_AGENT_ID_BRANDFLOW_CMO=
PAPERCLIP_AGENT_ID_CRYPTO_CEO=

# --- Telemetry (optional) ---
# Disable Paperclip's anonymous usage telemetry kalau lo concern
# PAPERCLIP_TELEMETRY_DISABLED=1

# --- Budget Reference (informational only — actual budgets di-set via API/UI) ---
# Format: cents per month (Paperclip's native budget unit)
# Rei (CEO):     200000 cents = $2000/month
# NexusAI CTO:   100000 cents = $1000/month
# BrandFlow CMO:  80000 cents = $800/month
# Crypto CEO:     80000 cents = $800/month
# TOTAL:         460000 cents = $4600/month (under $5000 company budget)
