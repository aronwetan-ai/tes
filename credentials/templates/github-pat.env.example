# GitHub Personal Access Token Template
# Copy ke ~/.agent/credentials/github-pat.env dan isi dengan real values
# chmod 600 ~/.agent/credentials/github-pat.env
#
# Akun: milik agent (NexusAI dev agents)
# Status: otonom untuk create repo, branch, PR, commit, push
# Batas: delete repo + force push ke main = wajib konfirmasi

# --- PAT (Classic atau Fine-grained) ---
# Generate di: https://github.com/settings/tokens
# Scopes minimal: repo, workflow, read:org
GITHUB_PAT=ghp_your_token_here
GITHUB_USERNAME=your_github_username

# --- Rotation reminder ---
# Rotate setiap 60 hari atau kalau scope berubah
# Last rotated: YYYY-MM-DD
